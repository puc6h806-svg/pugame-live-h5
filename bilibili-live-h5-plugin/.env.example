# 1 = 本地 mock（跳过 session/start，定时推 danmaku/gift）
# 0 或不设 = 真连后端（POST /api/session/start + WS /ws?token=）
VITE_MOCK=0

# 后端 HTTP 根。空则走同源 /api（dev 由 Vite proxy → 127.0.0.1:8787）
# 生产可填 https://your-api.example.com
VITE_API_BASE=

# 事件 WebSocket。空则走同源 /ws?token=（dev 同样走 Vite proxy，ws:true）
# 生产可填 wss://your-api.example.com/ws
VITE_WS_URL=
