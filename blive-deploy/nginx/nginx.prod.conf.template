# Production nginx — TLS for bilibili-live H5 plugin (same-origin /api + /ws)
# Generate: DOMAIN=plugin.example.com bash scripts/apply-domain.sh
# Certs (Let’s Encrypt defaults; override paths if you have existing certs):
#   /etc/letsencrypt/live/__DOMAIN__/fullchain.pem
#   /etc/letsencrypt/live/__DOMAIN__/privkey.pem
# ACME HTTP-01: keep listen 80 + /.well-known/acme-challenge/
# After certbot: nginx -c /workspace/blive-deploy/nginx/nginx.prod.conf

worker_processes auto;
error_log /tmp/blive-nginx-error.log warn;
pid /tmp/blive-nginx.pid;

events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
  }

  # HTTP: ACME challenge + redirect to HTTPS
  server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
      root /var/www/certbot;
      default_type text/plain;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    # Default Let’s Encrypt paths (replace __DOMAIN__ via apply-domain.sh)
    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    # If you already have certs elsewhere, point the two lines above to those paths.

    root /workspace/blive-deploy/current;
    index index.html;

    # Bilibili iframe — never DENY
    add_header Content-Security-Policy "frame-ancestors https://play-live.bilibili.com https://*.bilibili.com 'self'" always;
    add_header X-Frame-Options "ALLOW-FROM https://play-live.bilibili.com/" always;

    location /api/ {
      proxy_pass http://127.0.0.1:8787;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
      proxy_pass http://127.0.0.1:8787;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 86400;
    }

    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
