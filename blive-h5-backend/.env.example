# Bilibili Open Live Platform credentials (from developer email — never commit real values)
BILI_ACCESS_KEY_ID=
BILI_ACCESS_KEY_SECRET=
# Project / app id (numeric string; treated as int64 in API bodies)
BILI_APP_ID=

# Secret used to sign short-lived session tokens for the H5 frontend
SESSION_SECRET=

# HTTP listen port (default 8787)
PORT=8787

# Optional comma-separated CORS origins, e.g. https://example.com,http://localhost:5173
# Leave empty to allow all origins in development
# Production (same-origin H5 on pugame.site):
ALLOWED_ORIGINS=https://pugame.site
